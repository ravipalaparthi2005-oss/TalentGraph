# ==============================================================================
# TalentGraph - Environment Variable Template
# Copy this file to .env for local development. NEVER commit real secrets to Git.
# ==============================================================================

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# Database Configuration (PostgreSQL)
DATABASE_URL=jdbc:postgresql://localhost:5432/talentgraph
DATABASE_USERNAME=talentgraph
DATABASE_PASSWORD=talentgraph

# AI Configuration (OpenRouter - Isolated behind AiProvider interface)
OPENROUTER_API_KEY=
AI_PROVIDER=openrouter
AI_MODEL=openrouter/free

# Authentication Credentials
JWT_SECRET=dev_jwt_secret_key_change_in_production_min_32_bytes_long!
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# External Evidence Integrations
GITHUB_TOKEN=
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=

# Caching & Background Processing
REDIS_URL=redis://localhost:6379

# Frontend Config
VITE_API_BASE_URL=http://localhost:8080/api/v1
